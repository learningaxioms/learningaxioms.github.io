{
  "name": "axiom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AXIOM \u2014 math that actually teaches: interactive explorers, worked examples, misconception feedback, mastery + spaced review.",
  "scripts": {
    "dev": "vite --port 5200",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --port 5200",
    "check": "tsc -p .",
    "validate": "tsx scripts/validate.ts",
    "artifact": "SINGLE=1 vite build && node scripts/artifact.mjs",
    "deploy": "vite build --base=./ && node scripts/deploy.mjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "homepage": "https://learningaxioms.github.io/"
}